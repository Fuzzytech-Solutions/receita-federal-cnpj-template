# Copie para .env e troque as senhas. O .env nunca vai para o git.

# Postgres que recebe a base (o serviço "postgres" do compose, ou um seu)
POSTGRES_USER=cnpj
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cnpj
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cnpj:troque-esta-senha@postgres:5432/cnpj

# Schema de destino (padrão receita_federal)
CNPJ_SCHEMA=receita_federal
# true = guarda os .zip baixados (~7 GB/mês); false = apaga após carregar
CNPJ_MANTER_ZIPS=false

# Fonte oficial: compartilhamento público da Receita (Nextcloud/WebDAV).
# Só mude se a Receita trocar o endereço.
RFB_WEBDAV_URL=https://arquivos.receitafederal.gov.br/public.php/webdav/
RFB_SHARE_TOKEN=YggdBLfdninEJX9  # gitleaks:allow (link público da Receita, não é credencial)

# Airflow (opcional, perfil "airflow")
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha
AIRFLOW_PORT=8080
